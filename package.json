{
  "name": "memory-law",
  "version": "0.1.0",
  "description": "CLI conversation tool for Memory Law, built with pnpm and Bun.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test:myprovider": "bun src/scripts/testMyProvider.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun build ./src/index.ts --outdir dist",
    "type-check": "pnpm exec tsc --noEmit",
    "postinstall": "command -v bun >/dev/null 2>&1 && bun scripts/setup.ts || echo \"bun not found, skip postinstall\""
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "openai": "^6.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
